{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/:caminho*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/:caminho*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/aliancas-web/modelo-03LM/individuais/03LM.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/:caminho*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/obrigado",
      "destination": "/src/pages/obrigado/obrigado.html"
    },
    {
      "source": "/privacidade",
      "destination": "/src/pages/privacidade/privacidade.html"
    },
    {
      "source": "/admin",
      "destination": "/src/pages/admin/admin.html"
    },
    {
      "source": "/tabela",
      "destination": "/src/pages/tabela/tabela.html"
    },
    {
      "source": "/carteira",
      "destination": "/src/pages/carteira/carteira.html"
    },
    {
      "source": "/pedido",
      "destination": "/src/pages/pedido/pedido.html"
    }
  ],
  "redirects": [
    {
      "source": "/whatsapp",
      "destination": "/obrigado",
      "permanent": false
    },
    {
      "source": "/zap",
      "destination": "/obrigado",
      "permanent": false
    }
  ]
}
